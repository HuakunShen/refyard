{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "refyard-web",
  "main": "./apps/web/src/worker.ts",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./apps/web/build",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "vars": {
    "PUBLIC_API_ORIGINS": "",
  },
  "observability": {
    "enabled": true,
  },
}
