  "cards": [
    {
      "dot": "cyan",
      "title": "Trust boundary",
      "items": [
        "Loopback only; every read authenticated",
        "Pairing tickets single-use, minted only on trusted local channels"
      ]
    },
    {
      "dot": "emerald",
      "title": "Git safety",
      "items": [
        "One writer per common git directory",
        "Only Git Core builds argv; destructive ops back up first and fail closed"
      ]
    },
    {
      "dot": "violet",
      "title": "Native and embedded hosts",
      "items": [
        "Tauri, GPUI and the native CLI share one Rust ApplicationService: no JS runtime, no localhost HTTP",
        "SSH via the host's OpenSSH; capabilities reports every gap honestly"
      ]
    },
    {
      "dot": "amber",
      "title": "Provider axis",
      "items": [
        "Opt-in GitHub reads behind provider:manage scope",
        "Token never appears in responses or the journal"
      ]
    },
    {
      "dot": "rose",
      "title": "Embedded clients",
      "items": [
        "The Harness plugin mounts Refyard's SPA at /refyard and proxies to a service built from @refyard/host-node",
        "VS Code spawns refyard-native and keeps the bearer in the extension host; the webview never sees it"
      ]
    }
  ]
