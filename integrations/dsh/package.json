{
  "name": "dsh-plugin-refyard",
  "version": "0.1.1",
  "type": "module",
  "description": "The Refyard Git workbench as a DeepSeek Harness panel: history, changes, diffs, commits, branches and stashes for the repository the current session is working in.",
  "license": "AGPL-3.0-only",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuakunShen/refyard.git",
    "directory": "integrations/dsh"
  },
  "homepage": "https://github.com/HuakunShen/refyard#readme",
  "bugs": {
    "url": "https://github.com/HuakunShen/refyard/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "refyard",
    "git",
    "git-workbench"
  ],
  "meta": {
    "title": "Refyard",
    "description": "A Git workbench for the repository this session is working in."
  },
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "cd ../.. && pnpm build:dsh",
    "prepublishOnly": "pnpm build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
