# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
# The desktop flavour of the same SPA, and the working directory that keeps the two
# builds from sharing SvelteKit's intermediate output (see apps/web/svelte.config.js).
build-desktop
.svelte-kit-desktop
# The embedded-plugin flavour: served under a path prefix by an embedding host, which is
# also why it needs its own `paths.base` and its own intermediate directory.
build-dsh
.svelte-kit-dsh

# SvelteKit's generated types and route manifest (`svelte-kit sync`, run by `pnpm build`).
.svelte-kit

# Astro's generated types and content cache for the documentation site (`apps/docs`).
.astro

# Playwright's failure artifacts (traces, screenshots, page snapshots).
test-results
playwright-report


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

references

# The developer's global git ignore (~/.config/git/ignore) ignores AGENTS.md to
# keep agent instruction files out of other repositories. Here it is the project's
# rules and is meant to be tracked, and a repo-level pattern takes precedence.
!AGENTS.md

# Generated development build output (see scripts/bundle-cli.ts).
.refyard-dev/

# Generated publication staging (see scripts/build-release.ts). The manifest in
packages/npm-dist is source; everything it stages next to it is not.
packages/npm-dist/bin/
packages/npm-dist/dist/
packages/npm-dist/web/
packages/npm-dist/*.tgz

# Rust build output. `Cargo.lock` is tracked on purpose: the native crates form a
# workspace, and a released binary has to be reproducible from its lockfile.
target/

# Tauri's generated capability schemas: written by tauri-build from
# capabilities/*.json on every build, so they are output rather than source.
apps/desktop/src-tauri/gen/

