{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Refyard",
  "version": "0.1.2",
  "identifier": "dev.refyard.desktop",
  "build": {
    "frontendDist": "../../web/build-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Refyard",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
      "visible": false
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://github.com https://avatars.githubusercontent.com; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A Git workbench for the repository you already have.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEN0EyMzRDQkNDNDY1NkYKUldSdlpjUzhUQ042elErU3hxNG5ialRIZFR3QzU2REM4WDlRbU16N3VOalJtcTJDakt3YVdmbHQK",
      "endpoints": [
        "https://github.com/HuakunShen/refyard/releases/latest/download/latest.json"
      ]
    }
  }
}
