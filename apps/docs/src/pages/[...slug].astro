---
import { render, type CollectionEntry } from "astro:content";
import { Docs } from "@/components/docs";
import defaultMdxComponents from "fumadocs-ui/mdx";
import "@/styles/global.css";
import { source } from "@/lib/source";
import { getPageImageUrl } from "@/lib/shared";
import Layout from "@/components/layout.astro";
import type { TOCItemType } from "fumadocs-core/toc";

interface Props {
  page: CollectionEntry<"docs">;
}

export async function getStaticPaths() {
  return source.getPages().flatMap((page) => {
    const route = page.slugs.join("/");
    const canonical = {
      params: { slug: ["docs", ...page.slugs].join("/") },
      props: { page: page.data._raw },
    };
    // Keep existing deep links, while leaving `/` free for the product homepage.
    return route ? [canonical, { params: { slug: route }, props: canonical.props }] : [canonical];
  });
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const routeParts = typeof Astro.params.slug === "string" ? Astro.params.slug.split("/") : [];
const slugs = routeParts[0] === "docs" ? routeParts.slice(1) : routeParts;
const docsPage = source.getPage(slugs)!;
const image = getPageImageUrl(docsPage).url;
const canonicalUrl = new URL(docsPage.url, Astro.site).toString();

const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: "#" + heading.slug,
}));
---

<Layout>
  <title>{page.data.title}</title>
  <meta name="title" content={page.data.title} />
  <meta name="description" content={page.data.description} />
  <meta property="og:image" content={image} />
  <link rel="canonical" href={canonicalUrl} />
  <Docs
    tree={source.getPageTree()}
    pathname={Astro.url.pathname}
    params={Astro.params}
    page={{ toc }}
    client:load
  >
    <h1 class="font-semibold text-3xl">{page.data.title}</h1>
    <p class="text-lg text-fd-muted-foreground mb-8">{page.data.description}</p>
    <div class="prose flex-1">
      <Content components={{ ...defaultMdxComponents }} />
    </div>
  </Docs>
</Layout>
