{
  "name": "refyard",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:release": "turbo run build && bun scripts/build-release.ts",
    "dev": "bun scripts/dev.ts",
    "check": "turbo run check && tsc --noEmit -p tsconfig.json",
    "cli": "pnpm build:web && bun scripts/bundle-cli.ts && node .refyard-dev/cli.mjs",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:contract": "bun scripts/check-contract.ts",
    "pack:smoke": "bun scripts/pack-smoke.ts",
    "format": "prettier --write \"**/*.{ts,svelte,md,json,yaml}\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/contract tests/core tests/graph tests/web-host tests/workflow",
    "test:web-host": "vitest run tests/web-host",
    "test:integration": "vitest run tests/node tests/integration tests/security",
    "test:pack": "vitest run tests/pack",
    "test:portable": "bun scripts/check-portable.ts && vitest run tests/portable",
    "test:e2e": "pnpm build && bun scripts/bundle-cli.ts && playwright test",
    "test:compat": "pnpm build && bun scripts/bundle-cli.ts && playwright test --config tests/compat/playwright.config.ts",
    "bench:runtime": "bun scripts/bench-runtime.ts",
    "build:web": "pnpm --dir apps/web build",
    "deploy": "pnpm build:web && pnpm --dir apps/web exec wrangler deploy --config ../../wrangler.jsonc",
    "deploy:web": "pnpm --dir apps/web deploy",
    "deploy:web:dry-run": "pnpm --dir apps/web deploy:dry-run"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@refyard/backend-http": "workspace:*",
    "@refyard/cli": "workspace:*",
    "@refyard/git-client": "workspace:*",
    "@refyard/git-contract": "workspace:*",
    "@refyard/git-core": "workspace:*",
    "@refyard/git-graph": "workspace:*",
    "@refyard/git-service": "workspace:*",
    "@refyard/git-ui": "workspace:*",
    "@refyard/host-node": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "kkrpc": "catalog:",
    "oxc-parser": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "shadcn-svelte": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26 <27"
  }
}
